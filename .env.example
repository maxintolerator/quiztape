# ---------------------------------------------------------------------------
# Quiztape server-side environment. Copy to .env (never committed).
# Nothing in this file is ever shipped to the client bundle.
# ---------------------------------------------------------------------------

# Postgres connection string used by the API. Supabase: the transaction *pooler*
# URL (port 6543) is fine here. Any Postgres 15+ works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quiztape
# Optional: direct connection (Supabase port 5432) for `npm run db:migrate`.
# Falls back to DATABASE_URL when unset.
DATABASE_MIGRATE_URL=

# Last.fm API account: https://www.last.fm/api/account/create
# Only the key is needed: players sign in with their username, so nothing is signed.
LASTFM_API_KEY=

# MusicBrainz requires a meaningful User-Agent with a contact address.
MUSICBRAINZ_APP_NAME=Quiztape
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT=you@example.com

# Optional garnish: rephrasing and fuzzy-answer grading only. Never facts.
ANTHROPIC_API_KEY=

# API server
PORT=8787
# Comma-separated origins allowed to call the API from a browser (web target).
CORS_ORIGINS=http://localhost:8081
# Background jobs (MusicBrainz ingestion) run inside the API process by default.
WORKER_ENABLED=true
WORKER_ID=api-1
