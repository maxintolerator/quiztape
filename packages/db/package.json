{
  "name": "@quiztape/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema (Drizzle), migrations and the database client. Supabase-compatible.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./testing": {
      "types": "./src/test-db.ts",
      "default": "./src/test-db.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "render-docs": "tsx scripts/render-schema.ts",
    "check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "@quiztape/shared": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.10"
  }
}
